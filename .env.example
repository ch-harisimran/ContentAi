# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Not currently read by any code (no admin/service-role client is used) —
# safe to leave unset. Kept here as a placeholder in case that changes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter — free key from https://openrouter.ai/keys, no credit card needed
OPENROUTER_API_KEY=your-openrouter-api-key

# Flat monthly generation limit — one tier, no paid plan
MONTHLY_GENERATION_LIMIT=10
